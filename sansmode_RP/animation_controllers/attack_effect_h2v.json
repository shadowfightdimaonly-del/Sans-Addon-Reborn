        "snow": {
          "particle_effects": [
            {
              "effect": "sans",
              "locator": "sans"
            }
          ],
          "transitions": [
            {
              "error": "query.skin_id == 110 || query.skin_id == 111 || query.skin_id == 112"
            },
            {
              "dust": "query.variant >= 500 && query.variant < 600"
            },
            {
              "night": "query.variant >= 600 && query.variant < 700"
            },
            {
              "killer": "query.variant >= 700 && query.variant < 800"
            },
            {
              "horror": "query.variant>=800 && query.variant<900"
            },
            {
              "lastbreath": "query.variant >= 900 && query.variant < 1000"
            },
            {
              "gaster": "query.variant >= 1000"
            }
          ]
        },
        "error": {
          "particle_effects": [
            {
              "effect": "sans_error",
              "locator": "sans"
            }
          ],
          "transitions": [
            {
