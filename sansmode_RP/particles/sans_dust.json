{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sansmode:dust",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/particle/sans_dust" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 60 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_box": { "offset": [0, 0.9, 0], "half_dimensions": [0.35, 0.9, 0.25], "direction": "outwards" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "Math.random(1.2, 2.4)" },
      "minecraft:particle_initial_speed": "Math.random(0.2, 0.9)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0.15, 0.55, 0.1],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.09 + Math.random(0, 0.07)", "0.09 + Math.random(0, 0.07)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": { "0.0": "#FFFFFFFF", "0.7": "#FFFFFFFF", "1.0": "#00FFFFFF" }
        }
      }
    }
  }
}
