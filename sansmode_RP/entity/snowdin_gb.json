{
  "format_version": "1.8.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "sansmode:snowdin_gb",
      "materials": {
        "default": "psans",
        "invisible": "psans2",
        "t": "pgb"
      },
      "textures": {
        "default": "psans_blaster",
        "t": "PGBP0"
      },
      "geometry": {
        "default": "geometry.pcraw",
        "t": "geometry.psansfire"
      },
      "animations": {
        "pgb_move": "animation.pgb_move"
      },
      "scripts": {
        "pre_animation": [
          "variable.shake = query.shake_time - query.frame_alpha;",
          "variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
        ]
      },
      "animation_controllers": [
        {
          "psans": "controller.animation.psans"
        }
      ],
      "render_controllers": [
        "controller.render.psans2",
        "controller.render.pcraw"
      ],
      "enable_attachables": true
    }
  }
}