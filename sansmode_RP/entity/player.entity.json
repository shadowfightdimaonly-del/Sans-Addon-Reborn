        "blink": "controller.animation.persona.blink",
        "nm_reach": "animation.nightmare_reach",
        "sans_pocket_l": "animation.sans_pocket_l",
        "sans_hand": "controller.animation.sans_hand",
        "sans_pocket_r": "animation.sans_pocket_r",
        "sans_fwd_hold": "animation.sans_fwd_hold",
        "sans_up_hold": "animation.sans_up_hold",
        "sans_side_hold": "animation.sans_side_hold",
        "sans_cir_hold": "animation.sans_cir_hold",
        "sans_fwd_cast": "animation.sans_fwd_cast",
        "sans_up_cast": "animation.sans_up_cast",
